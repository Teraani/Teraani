
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Any authenticated user can read leagues, but only league members can write.
    // More granular rules can be added later (e.g., only admin can edit certain fields).
    match /leagues/{leagueId} {
      allow read: if request.auth != null;
      // Allow writes only if the user is part of the league's user list.
      // This is a basic security rule to prevent unauthorized modifications.
      allow write: if request.auth != null && request.auth.uid == resource.data.adminId || request.auth.uid in resource.data.users;
    }
  }
}
