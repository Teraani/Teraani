rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to simplify referencing the collection.
    function collection() {
      return request.path[6];
    }
    // Only authenticated users can read or write to the users and leagues collections.
    match /{collection}/{docId} {
      allow read, write: if request.auth != null && (collection == 'users' || collection == 'leagues');
    }
  }
}